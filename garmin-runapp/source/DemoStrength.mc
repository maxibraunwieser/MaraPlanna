            return { "ex" => [{ "i" => "plank", "n" => "Unterarmstütz", "f" => "core", "s" => 3, "r" => 0, "rest" => 45, "a" => "plank", "m" => 2, "h" => 45 }, { "i" => "side_plank", "n" => "Seitstütz", "f" => "core", "s" => 3, "r" => 0, "rest" => 45, "a" => "side_plank", "m" => 2, "h" => 30 }, { "i" => "dead_bug", "n" => "Dead Bug", "f" => "core", "s" => 3, "r" => 10, "rest" => 45, "a" => "dead_bug", "m" => 0 }, { "i" => "bird_dog", "n" => "Bird Dog", "f" => "core", "s" => 3, "r" => 10, "rest" => 45, "a" => "bird_dog", "m" => 1 }, { "i" => "pallof", "n" => "Pallof Press", "f" => "core", "s" => 3, "r" => 10, "rest" => 45, "a" => "pallof", "m" => 0 }, { "i" => "hanging_knee", "n" => "Hängendes Knieheben", "f" => "core", "s" => 3, "r" => 10, "rest" => 60, "a" => "hanging_knee", "m" => 0 }, { "i" => "crunches", "n" => "Crunches", "f" => "core", "s" => 3, "r" => 10, "rest" => 60, "a" => "crunches", "m" => 1 }, { "i" => "bicycle_crunches", "n" => "Bicycle Crunches", "f" => "core", "s" => 3, "r" => 10, "rest" => 60, "a" => "bicycle_crunches", "m" => 1 }, { "i" => "beinheben_liegend", "n" => "Beinheben liegend", "f" => "core", "s" => 3, "r" => 10, "rest" => 60, "a" => "beinheben_liegend", "m" => 1 }, { "i" => "haengendes_beinheben", "n" => "Hängendes Beinheben", "f" => "core", "s" => 3, "r" => 10, "rest" => 60, "a" => "haengendes_beinheben", "m" => 1 }, { "i" => "dragon_flag", "n" => "Dragon Flag", "f" => "core", "s" => 3, "r" => 10, "rest" => 60, "a" => "dragon_flag", "m" => 1 }, { "i" => "plank_mit_kettlebell_drag", "n" => "Plank mit Kettlebell-D", "f" => "core", "s" => 3, "r" => 10, "rest" => 60, "a" => "plank_mit_kettlebell_drag", "m" => 0 }] } as Dictionary<Application.Storage.KeyType, Application.Storage.ValueType>;
